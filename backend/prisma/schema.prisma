// =============================================
// OrderHub B2B — Esquema de base de datos
// Montos en pesos chilenos enteros (CLP no usa decimales).
// =============================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  admin
  vendedor
  bodega

  @@map("user_role")
}

enum OrderStatus {
  pendiente_pago
  pagado
  preparando
  despachado
  entregado
  cancelado

  @@map("order_status")
}

enum PaymentProvider {
  mercadopago

  @@map("payment_provider")
}

enum PaymentStatus {
  pendiente
  aprobado
  rechazado
  cancelado
  reembolsado

  @@map("payment_status")
}

// ---------- Empresas (tenants) ----------
model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  // Último número de pedido usado por la empresa (correlativo propio, sin huecos).
  orderSeq  Int      @default(0) @map("order_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users      User[]
  products   Product[]
  orders     Order[]
  orderItems OrderItem[]
  payments   Payment[]

  @@map("tenants")
}

// ---------- Usuarios ----------
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders        Order[]
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("users")
}

// ---------- Productos ----------
model Product {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sku       String
  name      String
  price     Int
  stock     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@map("products")
}

// ---------- Pedidos ----------
model Order {
  id        String      @id @default(uuid(7)) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  // Número legible y correlativo por empresa (#1, #2, ...). Sale de tenants.order_seq.
  number    Int
  sellerId  String      @map("seller_id") @db.Uuid
  status    OrderStatus @default(pendiente_pago)
  total     Int
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  seller   User        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  // Cada empresa tiene su propio correlativo; también sirve para buscar por número.
  @@unique([tenantId, number])
  // Paginación por cursor: "los pedidos de esta empresa, del más nuevo al más antiguo".
  @@index([tenantId, createdAt(sort: Desc), id])
  // Filtro por estado dentro de una empresa.
  @@index([tenantId, status])
  @@map("orders")
}

// ---------- Ítems de pedido ----------
model OrderItem {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Int    @map("unit_price")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------- Pagos ----------
model Payment {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  orderId    String          @map("order_id") @db.Uuid
  provider   PaymentProvider
  externalId String?         @map("external_id")
  status     PaymentStatus   @default(pendiente)
  amount     Int
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([orderId])
  @@map("payments")
}

// ---------- Eventos de webhook (idempotencia) ----------
model WebhookEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id")
  payload     Json
  receivedAt  DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?       @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ---------- Refresh tokens (sesiones) ----------
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Todos los tokens de una misma sesión comparten familia (para detectar reuso).
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}