# ---------- PostgreSQL (contenedor Docker) ----------
POSTGRES_USER=orderhub
POSTGRES_PASSWORD=orderhub_dev
POSTGRES_DB=orderhub
POSTGRES_PORT=5433

# ---------- Redis (contenedor Docker) ----------
REDIS_PORT=6390

# ---------- Backend: conexión a la base ----------
DATABASE_URL=postgresql://orderhub_app:orderhub_app_dev@localhost:5433/orderhub?schema=public
DATABASE_ADMIN_URL=postgresql://orderhub:orderhub_dev@localhost:5433/orderhub?schema=public

DB_LOG_QUERIES=false

# ---------- Backend: servidor ----------
NODE_ENV=development
API_PORT=3001

# URL del frontend (para permitir sus peticiones con CORS)
FRONTEND_URL=http://localhost:3000

# URL con la que el backend se llama a sí mismo, sin /api (la usa la pasarela simulada)
API_INTERNAL_URL=http://localhost:3001

# ---------- Backend: JWT ----------
JWT_ACCESS_SECRET=dev-access-secret-cambiar-en-produccion-0001
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Backend: pasarela de pago simulada ----------
# Firma los webhooks (HMAC-SHA256). Mínimo 32 caracteres. Genera uno propio en tu .env.
FAKE_PAY_WEBHOOK_SECRET=dev-fake-pay-secret-cambiar-en-produccion-01