# ---------- PostgreSQL (contenedor Docker) ----------
POSTGRES_USER=orderhub
POSTGRES_PASSWORD=orderhub_dev
POSTGRES_DB=orderhub
POSTGRES_PORT=5433

# ---------- Redis (contenedor Docker) ----------
REDIS_PORT=6390

# ---------- Backend: conexión a la base ----------
DATABASE_URL=postgresql://orderhub:orderhub_dev@localhost:5433/orderhub?schema=public

# ---------- Backend: servidor ----------
NODE_ENV=development
API_PORT=3001

# URL del frontend (para permitir sus peticiones con CORS)
FRONTEND_URL=http://localhost:3000

# ---------- Backend: JWT ----------
# Secreto de al menos 32 caracteres. En tu .env usa un valor aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-cambiar-en-produccion-0001
# Duración del access token (JWT) y del refresh token (guardado en la base)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d